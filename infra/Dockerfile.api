FROM python:3.11-slim

WORKDIR /app

# Install uv
RUN pip install uv

# Copy project files
COPY pyproject.toml .
COPY . .

# Install core deps (no spark/heavy extras for API)
RUN uv pip install --system ".[s3,neo4j]" && \
    uv pip install --system fastapi uvicorn[standard] groq anthropic structlog python-jose[cryptography] passlib[bcrypt] networkx Levenshtein

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
